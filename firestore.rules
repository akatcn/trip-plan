rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 문서 ID(PIN에서 만든 64자리 값)를 아는 사람만 읽고 쓸 수 있다.
    // 목록 조회(list)는 막아서 다른 여행을 훑어볼 수 없게 한다.
    match /trips/{tripId} {
      allow get: if tripId.size() == 64;
      allow create, update: if tripId.size() == 64
        && request.resource.data.keys().hasOnly(['iv', 'data'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
      allow list, delete: if false;
    }
  }
}
