rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // trips/{tripId}/blocks/{blockId}
    // tripId는 비밀번호에서 만든 64자리 값이라, 비밀번호를 아는 사람만 경로를 알 수 있다.
    // 다른 여행 목록(trips)은 조회할 수 없다. 내용은 { iv, data } 암호문만 허용한다.
    match /trips/{tripId}/blocks/{blockId} {
      allow read, delete: if tripId.size() == 64;
      allow create, update: if tripId.size() == 64
        && request.resource.data.keys().hasOnly(['iv', 'data'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 200000;
    }
  }
}
